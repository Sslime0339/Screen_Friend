<Window x:Class="VirtualFriend.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualFriend.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <!-- Заголовок меню -->
            <TextBlock Text="РИХЭЫШЪЕ" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Foreground="White" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,40"/>

            <!-- Кнопка Начать/Продолжить (просто закрывает меню и возвращает к игре) -->
            <Button Content="Вернуться к игре" 
                Height="45" 
                Margin="0,0,0,15" 
                FontSize="16"
                Click="ResumeButton_Click"/>

            <!-- Кнопка Настройки -->
            <Button Content="Настройки и Инструкция" 
                Height="45" 
                Margin="0,0,0,15" 
                FontSize="16"
                Click="SettingsButton_Click"/>

            <!-- Кнопка Выход -->
            <Button Content="Выйти из программы" 
                Height="45" 
                FontSize="16"
                Background="#C0392B"
                Foreground="White"
                Click="ExitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
