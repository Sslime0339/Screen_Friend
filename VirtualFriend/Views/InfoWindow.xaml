<Window x:Class="VirtualFriend.Views.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualFriend.Views"
        mc:Ignorable="d"
        Title="Инструкция по управлению"
        Width="450"
        Height="370"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1A1A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="60*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.RowSpan="2">
            <TextBlock Text="Управление симуляцией" FontSize="20" FontWeight="Bold" Foreground="#3498DB" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <Border Background="#262626" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="• Клавиша [ C ] — Создать коробку под курсором" Foreground="White" FontSize="14" Margin="0,4"/>
                    <TextBlock Text="• Клавиша [ X ] — Очистить все коробки со сцены" Foreground="White" FontSize="14" Margin="0,4"/>
                    <TextBlock Text="• Зажатие ЛКМ — Взять и перетаскивать объект" Foreground="White" FontSize="14" Margin="0,4"/>
                    <TextBlock Text="• Колёсико мыши — Вращать коробку при удержании" Foreground="White" FontSize="14" Margin="0,4"/>
                    <!--
                    <TextBlock Text="• Клавиша [ I ] — Открыть главное меню программы" Foreground="#E67E22" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    -->
                    <TextBlock Text="• Клавиша [ ESC ] — Закрывает программу если &#x0a;закрыто главное меню" Foreground="#E67E22" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="Понятно" Width="100" Height="30" Margin="0,15,0,0" HorizontalAlignment="Center" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
